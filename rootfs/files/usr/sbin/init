#!/bin/busybox sh
#
# /sbin/init of the IoT-LAB gateway root filesystem, the same for every
# gateway type booting the image (A8, Raspberry Pi 2/3/4 with the armhf
# image, Raspberry Pi 5 with the arm64 image).
#
# The kernel mounts the root filesystem from the read-only NFS export of
# the gateway image. This script stacks a RAM overlay (tmpfs) on top of it
# so that the system can write anywhere, then starts systemd on the union.
# Everything written is lost at reboot: the gateway always restarts from
# the image content.
#
# Kernel command line parameters:
#   iotlab.overlay_size=<size>  size of the RAM overlay (tmpfs size option),
#                               25% of the RAM by default
#   iotlab.overlay=0            don't stack the overlay (debug only: the
#                               root filesystem stays read-only)

bb=/bin/busybox
systemd=/usr/lib/systemd/systemd
# Arguments given by the kernel to init, passed on to systemd (split on
# purpose when used, hence the SC2086 exceptions)
init_args="$*"

cmdline_param() {
    for arg in $($bb cat /proc/cmdline); do
        case "$arg" in
            "$1"=*) echo "${arg#*=}"; return ;;
        esac
    done
}

fallback() {
    echo "iotlab-init: $1, starting systemd on the read-only root" > /dev/console
    $bb umount /proc 2>/dev/null
    # shellcheck disable=SC2086
    exec $systemd $init_args
}

$bb mount -t proc proc /proc
$bb mount -t devtmpfs devtmpfs /dev 2>/dev/null

if [ "$(cmdline_param iotlab.overlay)" = "0" ]; then
    fallback "overlay disabled on the command line"
fi

overlay_size=$(cmdline_param iotlab.overlay_size)
overlay_size=${overlay_size:-25%}

# overlayfs is a module on the Raspberry Pi kernels, built in on the A8
# kernel (without module support): modprobe fails there, silently
/usr/sbin/modprobe overlay 2>/dev/null

$bb mount -t tmpfs -o mode=0755,size="$overlay_size" overlay-ram /overlay \
    || fallback "can't mount the overlay tmpfs"
$bb mkdir -p /overlay/lower /overlay/upper /overlay/work /overlay/root

# A non recursive bind mount of / gives the NFS root alone, without the
# tmpfs mounted on /overlay
$bb mount --bind / /overlay/lower || fallback "can't bind mount the root"
$bb mount -t overlay overlay \
    -o lowerdir=/overlay/lower,upperdir=/overlay/upper,workdir=/overlay/work \
    /overlay/root || fallback "can't mount the overlay"

$bb mount --move /dev /overlay/root/dev
$bb umount /proc

cd /overlay/root || fallback "can't enter the overlay"
# The previous root (NFS and tmpfs) stays reachable under /mnt/oldroot
$bb pivot_root . mnt/oldroot || fallback "pivot_root failed"
# shellcheck disable=SC2086,SC2094
exec $bb chroot . $systemd $init_args < dev/console > dev/console 2>&1
