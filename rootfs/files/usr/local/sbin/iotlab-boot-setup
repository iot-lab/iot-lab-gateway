#!/bin/bash
#
# Boot time setup of the IoT-LAB gateway, run by iotlab-boot-setup.service
# before the gateway services. The network is already configured by the
# kernel (ip=dhcp, NFS root):
# - name resolution from the DHCP configuration of the kernel
# - nfsserver and networkgateway host names (NFS server and default router)
# - time synchronization with the default router (chrony)
# - node configuration (/var/local/config) and users (/iotlab/users)
#   directories, mounted from the site NFS server
# - host name of the node, from its configuration directory

set -eu

IFACE=eth0
CONF_DIR=/var/local/config
USERS_DIR=/iotlab/users
NFS_OPTIONS="rw,relatime,vers=3,rsize=131072,wsize=131072,hard,nolock,proto=tcp,timeo=600,retrans=2"

nfs_server=$(grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" /proc/net/nfsfs/servers | head -1)
router=$(ip -4 route show default dev "$IFACE" | sed -n 's/^default via \([0-9.]*\).*/\1/p' | head -1)
ip_addr=$(ip -4 -o addr show dev "$IFACE" | grep -v secondary | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -1)

if [ -z "$nfs_server" ] || [ -z "$ip_addr" ]; then
    echo "iotlab-boot-setup: NFS server ('$nfs_server') or address ('$ip_addr') not found" >&2
    exit 1
fi

# The kernel writes the DNS servers it got from DHCP in /proc/net/pnp
ln -sf /proc/net/pnp /etc/resolv.conf

sed -i -e '/[[:space:]]nfsserver$/d' -e '/[[:space:]]networkgateway$/d' /etc/hosts
echo "$nfs_server nfsserver" >> /etc/hosts
if [ -n "$router" ]; then
    echo "$router networkgateway" >> /etc/hosts
    # chrony.conf reads the sources of /run/chrony-dhcp (Debian default)
    mkdir -p /run/chrony-dhcp
    echo "server $router iburst" > /run/chrony-dhcp/iotlab.sources
fi

mkdir -p "$CONF_DIR" "$USERS_DIR"
if ! mountpoint -q "$CONF_DIR"; then
    mount -t nfs -o "$NFS_OPTIONS" "$nfs_server:/iotlab/images/$ip_addr/conf" "$CONF_DIR"
fi
if ! mountpoint -q "$USERS_DIR"; then
    mount -t nfs -o "$NFS_OPTIONS" "$nfs_server:/iotlab/users" "$USERS_DIR"
fi

if [ -s "$CONF_DIR/hostname" ]; then
    head -1 "$CONF_DIR/hostname" > /proc/sys/kernel/hostname
fi
