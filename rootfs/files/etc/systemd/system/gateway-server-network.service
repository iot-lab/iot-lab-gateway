[Unit]
Description=IoT-LAB gateway open node addresses (gateways with several open nodes)
Requires=iotlab-gateway-setup.service
After=iotlab-gateway-setup.service
Before=gateway-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gateway-server-network start
ExecStop=/usr/local/sbin/gateway-server-network stop

[Install]
WantedBy=multi-user.target
