[Unit]
Description=IoT-LAB gateway REST server
Requires=iotlab-gateway-setup.service
After=iotlab-gateway-setup.service gateway-server-network.service

[Service]
# gateway-server-daemon starts one server per open node in the background
# (start-stop-daemon), the servers stay in the cgroup of this unit
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gateway-server-daemon start
ExecStop=/usr/local/sbin/gateway-server-daemon stop

[Install]
WantedBy=multi-user.target
