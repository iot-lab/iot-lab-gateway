[Unit]
Description=IoT-LAB gateway boot time setup (name resolution, time, NFS mounts)
After=local-fs.target
Before=chrony.service ssh.service gateway-server-network.service gateway-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/iotlab-boot-setup

[Install]
WantedBy=multi-user.target
