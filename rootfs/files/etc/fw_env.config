# U-Boot environment of the A8 (var-som-am35) gateways, for fw_printenv and
# fw_setenv (libubootenv-tool), same as the Yocto images. Not used on the
# Raspberry Pi gateways (no NAND). Writing needs the mtd-rw kernel: the
# NAND partitions are read-only with the normal kernel.

# NAND config
# MTD device name	Device offset	Env. size	Flash sector size	Number of sectors
/dev/mtd2		0x0000		0x20000		0x20000			2
