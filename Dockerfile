# Images of the gateway code, sharing the same tools and gateway installation
# (stages tools and gateway):
#
# - dev (default target): runs the gateway REST server in a container, see
#   DOCKER.md. Image fitiotlab/iot-lab-gateway, base of the tests image.
#
#       docker build -t fitiotlab/iot-lab-gateway .
#
# - rootfs: root filesystem of the IoT-LAB gateways, deployed by
#   iot-lab-install and booted read-only over NFS, see rootfs/README.md.
#   Platforms linux/arm/v7 (A8, Raspberry Pi 2/3/4), linux/arm64 (RPi 5).
#
#       docker buildx build --target rootfs --platform linux/arm/v7 \
#           --build-context a8-kernel=<deploy dir of the iot-lab-yocto a8 target> .

ARG DEBIAN_RELEASE=trixie

# Optional inputs of the rootfs target, empty unless given as named build
# contexts:
#   a8-kernel: deploy directory of the iot-lab-yocto a8 target (uImage and
#              modules-var-som-am35.tgz), used for linux/arm/v7 only
#   jlink:     extracted Segger J-Link software for the target architecture,
#              installed in /usr/local/share/JLink (not redistributable)
FROM scratch AS a8-kernel
FROM scratch AS jlink

#
# tools: tools used by the gateway code and not packaged in Debian, built
# from pinned revisions and installed under /out
#
FROM debian:${DEBIAN_RELEASE} AS tools

ARG OPENOCD_REV=v0.11.0
ARG OPENOCD_DEV_REV=7c88e76a76588fa0e3ab645adfc46e8baff6a3e4
ARG OML_REV=f3bffca8ca721678bcb61a716765ae4f4cae3fd7
ARG CONTROL_NODE_SERIAL_REV=3eee15a5d48d3e1536e42bd074ad351de6a5334d
ARG FTDI_UTILS_REV=1.1.0
ARG EDBG_REV=80c50d03aac831f87f513a5d5455df1286bcb540
ARG YKUSH_REV=30d490423782a1d5379d1691a2539fad6ff6046d
ARG MJPG_STREAMER_REV=8cc9d22c1e79905d529a248ccf05bbf0625e0bf3
ARG CC2538_BSL_REV=c6100a7794c7b530923145c03e37412013a4551e
ARG PYCOM_UTILS_REV=80aacc4b36df5d59d783c987fca77d83b12f7bf2

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        git \
        gnulib \
        libftdi1-dev \
        libhidapi-dev \
        libjpeg-dev \
        libpopt-dev \
        libsqlite3-dev \
        libtool \
        libudev-dev \
        libusb-1.0-0-dev \
        libxml2-dev \
        pkgconf \
        # oml2 build: test sources generated by python scripts
        python3 \
        ruby \
        texinfo \
        u-boot-tools \
        && \
    rm -rf /var/lib/apt/lists/*

# These tools predate GCC 14, which turns some old C idioms into errors
ENV CFLAGS="-O2 -fcommon -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion"

WORKDIR /src

# git_checkout <url> <revision> <directory>
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -e' \
        'git clone --quiet "$1" "$3"' \
        'git -C "$3" checkout --quiet "$2"' \
        > /usr/local/bin/git_checkout && \
    chmod 755 /usr/local/bin/git_checkout

# openocd: /usr/local/bin/openocd (v0.11.0) and /opt/openocd-dev (more
# recent revision), the paths used by the gateway code
RUN git_checkout https://github.com/openocd-org/openocd.git ${OPENOCD_REV} openocd && \
    cd openocd && ./bootstrap && \
    ./configure --prefix=/usr/local --disable-werror \
        --enable-ftdi --enable-cmsis-dap --enable-hidapi-libusb && \
    make -j"$(nproc)" && make DESTDIR=/out install

RUN git_checkout https://github.com/openocd-org/openocd.git ${OPENOCD_DEV_REV} openocd-dev && \
    cd openocd-dev && ./bootstrap && \
    ./configure --prefix=/opt/openocd-dev --disable-werror \
        --enable-ftdi --enable-cmsis-dap --enable-hidapi-libusb --enable-jlink && \
    make -j"$(nproc)" && make DESTDIR=/out install

# oml2, needed by control_node_serial: installed in /usr/local (in /out for
# the images and in / to build control_node_serial)
RUN git_checkout https://github.com/iot-lab/oml.git ${OML_REV} oml && \
    cd oml && ./autogen.sh && \
    ./configure --prefix=/usr/local --disable-doc --disable-doxygen-doc \
        --disable-doxygen-dot --disable-android --disable-doxygen-html \
        --disable-option-checking && \
    make -j"$(nproc)" && make DESTDIR=/out install && make install && ldconfig

RUN git_checkout https://github.com/iot-lab/control_node_serial.git ${CONTROL_NODE_SERIAL_REV} control_node_serial && \
    make -C control_node_serial && \
    install -D -m 755 control_node_serial/control_node_serial_interface \
        /out/usr/bin/control_node_serial_interface

RUN git_checkout https://github.com/iot-lab/iot-lab-ftdi-utils.git ${FTDI_UTILS_REV} ftdi-utils && \
    cd ftdi-utils && \
    make CFLAGS="$CFLAGS $(pkg-config --cflags-only-I libftdi1) -DLIBFTDI1=1" \
        LDFLAGS="$(pkg-config --libs libftdi1)" && \
    install -D -m 755 -t /out/usr/bin ftdi-devices-list ftdi-eeprom-config

RUN git_checkout https://github.com/ataradov/edbg.git ${EDBG_REV} edbg && \
    make -C edbg all && \
    install -D -m 755 edbg/edbg /out/usr/bin/edbg

RUN git_checkout https://github.com/Yepkit/ykush.git ${YKUSH_REV} ykush && \
    # its Makefile takes the include paths from $PWD: build from its directory
    cd ykush && make && \
    install -D -m 755 bin/ykushcmd /out/usr/bin/ykushcmd

RUN git_checkout https://github.com/jacksonliam/mjpg-streamer.git ${MJPG_STREAMER_REV} mjpg-streamer && \
    cd mjpg-streamer/mjpg-streamer-experimental && \
    make CMAKE_BUILD_TYPE=Release && make DESTDIR=/out install

RUN git_checkout https://github.com/JelmerT/cc2538-bsl.git ${CC2538_BSL_REV} cc2538-bsl && \
    install -D -m 755 cc2538-bsl/cc2538-bsl.py /out/usr/bin/cc2538-bsl.py

RUN git_checkout https://github.com/iot-lab/pycom-utils.git ${PYCOM_UTILS_REV} pycom-utils && \
    install -d /out/usr/local/share/pycom/eps32/tools/fw_updater && \
    cp pycom-utils/*.py /out/usr/local/share/pycom/eps32/tools/fw_updater/

# Second stage U-Boot script of the Raspberry Pi 2/3/4 gateways (rootfs)
COPY rootfs/boot/rpi-uboot.cmd /src/
RUN mkdir -p /boot-files && \
    mkimage -A arm -O linux -T script -C none -n "IoT-LAB gateway" \
        -d /src/rpi-uboot.cmd /boot-files/rpi-uboot.scr

#
# gateway: the gateway code, its udev rules and the tools it uses
#
FROM debian:${DEBIAN_RELEASE} AS gateway

LABEL maintainer="IoT-LAB <admin@iot-lab.info>"

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        avarice \
        avrdude \
        ca-certificates \
        curl \
        libftdi1-2 \
        libhidapi-hidraw0 \
        libhidapi-libusb0 \
        libjpeg62-turbo \
        libpopt0 \
        libsqlite3-0 \
        libudev1 \
        libusb-1.0-0 \
        libxml2 \
        mosquitto \
        openssh-client \
        python3 \
        python3-bottle \
        python3-intelhex \
        python3-paste \
        python3-pip \
        python3-pyelftools \
        python3-serial \
        rtl-sdr \
        socat \
        sudo \
        uhubctl \
        usbutils \
        && \
    rm -rf /var/lib/apt/lists/*

COPY --from=tools /out/ /
COPY --from=jlink / /usr/local/share/JLink/
RUN ldconfig

# Gateway code, dependencies from the Debian packages above
COPY . /tmp/gateway
RUN pip install --no-cache-dir --no-deps --break-system-packages /tmp/gateway && \
    install -D -m 644 -t /etc/udev/rules.d /tmp/gateway/bin/rules.d/*.rules && \
    install -D -m 755 /tmp/gateway/bin/init_script/gateway-server-daemon \
        /usr/local/sbin/gateway-server-daemon && \
    rm -rf /tmp/gateway

# www-data runs the gateway server: serial ports, home for its ssh keys
RUN usermod -a -G dialout,plugdev www-data && \
    install -d -o www-data -g www-data -m 755 /var/www && \
    install -d -o www-data -g www-data -m 700 /var/www/.ssh && \
    mkdir -p /var/local/config /iotlab/users

#
# rootfs: root filesystem of the gateways (rootfs/README.md)
#
FROM gateway AS rootfs

ARG DEBIAN_RELEASE
ARG RASPBERRYPI_ARCHIVE=http://archive.raspberrypi.com/debian

# Kernels of the Raspberry Pi gateways come from the Raspberry Pi archive,
# pinned so that only the packages explicitly requested come from it
COPY rootfs/files/etc/apt/preferences.d/raspberrypi /etc/apt/preferences.d/raspberrypi
ADD https://archive.raspberrypi.com/debian/raspberrypi.gpg.key /tmp/raspberrypi.gpg.key
RUN apt-get update && \
    apt-get install -y --no-install-recommends gpg && \
    gpg --dearmor -o /usr/share/keyrings/raspberrypi-archive-keyring.gpg /tmp/raspberrypi.gpg.key && \
    rm /tmp/raspberrypi.gpg.key && \
    printf '%s\n' \
        "Types: deb" \
        "URIs: ${RASPBERRYPI_ARCHIVE}" \
        "Suites: ${DEBIAN_RELEASE}" \
        "Components: main" \
        "Signed-By: /usr/share/keyrings/raspberrypi-archive-keyring.gpg" \
        > /etc/apt/sources.list.d/raspberrypi.sources && \
    apt-get purge -y --auto-remove gpg && \
    rm -rf /var/lib/apt/lists/*

# System of a netbooted gateway. No systemd-sysv: /sbin/init is the overlay
# init script of the image
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        busybox-static \
        chrony \
        iproute2 \
        iputils-ping \
        kmod \
        less \
        logrotate \
        nfs-common \
        openssh-server \
        procps \
        psmisc \
        systemd \
        udev \
        vim-tiny \
        && \
    rm -rf /var/lib/apt/lists/*

# Kernels, device trees and boot files, gathered per gateway type in
# /boot/iotlab/<type> (copied to the site TFTP server by iot-lab-install)
COPY --from=tools /boot-files/rpi-uboot.scr /tmp/rpi-uboot.scr
COPY rootfs/boot/rpi5/config.txt /tmp/rpi5-config.txt
COPY --from=a8-kernel / /tmp/a8-kernel/
RUN set -eu; \
    rpi_boot() { \
        flavour=$1; target=$2; kernel=$3; dtbs=$4; \
        mkdir -p /boot/iotlab/$target; \
        cp /boot/vmlinuz-*-rpi-$flavour /boot/iotlab/$target/$kernel; \
        find /usr/lib/linux-image-*-rpi-$flavour -name "$dtbs" \
            -exec cp {} /boot/iotlab/$target/ \; ; \
    }; \
    apt-get update; \
    case "$(dpkg --print-architecture)" in \
    armhf) \
        apt-get install -y --no-install-recommends \
            linux-image-rpi-v7 linux-image-rpi-v7l; \
        rpi_boot v7 rpi2 zImage 'bcm27*.dtb'; \
        rpi_boot v7 rpi3 zImage 'bcm27*.dtb'; \
        rpi_boot v7l rpi4 zImage 'bcm27*.dtb'; \
        for target in rpi2 rpi3 rpi4; do \
            cp /tmp/rpi-uboot.scr /boot/iotlab/$target/boot.scr; \
        done; \
        mkdir -p /boot/iotlab/a8; \
        if [ -e /tmp/a8-kernel/uImage ]; then \
            cp -L /tmp/a8-kernel/uImage /boot/iotlab/a8/uImage; \
        fi; \
        if [ -e /tmp/a8-kernel/modules-var-som-am35.tgz ]; then \
            tar -xzf /tmp/a8-kernel/modules-var-som-am35.tgz -C /; \
        fi; \
        ;; \
    arm64) \
        apt-get install -y --no-install-recommends linux-image-rpi-2712; \
        rpi_boot 2712 rpi5 Image 'bcm2712*.dtb'; \
        cp -r "$(find /usr/lib/linux-image-*-rpi-2712 -type d -name overlays | head -1)" \
            /boot/iotlab/rpi5/overlays; \
        cp /tmp/rpi5-config.txt /boot/iotlab/rpi5/config.txt; \
        ;; \
    *) \
        echo "unsupported architecture $(dpkg --print-architecture)"; exit 1 ;; \
    esac; \
    rm -rf /tmp/rpi-uboot.scr /tmp/rpi5-config.txt /tmp/a8-kernel \
        /boot/vmlinuz-* /boot/initrd.img-* /boot/System.map-* /boot/config-* \
        /var/lib/apt/lists/*

# Boot and services configuration
COPY rootfs/files/ /
RUN chmod 440 /etc/sudoers.d/www-data && \
    systemctl enable iotlab-boot-setup.service gateway-server-network.service \
        gateway-server.service chrony.service ssh.service && \
    # the kernel configures eth0 for the NFS root: keep the kernel interface
    # names (the gateway code uses eth0) and never touch the network
    mkdir -p /etc/systemd/network && \
    ln -sf /dev/null /etc/systemd/network/99-default.link && \
    # mount points of the overlay init (/sbin/init)
    mkdir -p /overlay /mnt/oldroot && \
    # empty machine-id: generated at each boot, unique per node
    : > /etc/machine-id && \
    : > /etc/fstab && \
    rm -f /etc/ssh/ssh_host_*

#
# dev: gateway REST server in a container (default target), see DOCKER.md
#
FROM gateway AS dev

RUN mkdir -p /iotlab/users/test && \
    chown www-data:www-data /iotlab/users/test

CMD ["gateway-rest-server", "0.0.0.0", "8080", "--log-stdout", "--reloader"]
