# Images of the gateway code:
#
# - dev (default target): runs the gateway REST server in a container, see
#   DOCKER.md. Image fitiotlab/iot-lab-gateway.
#
#       docker build -t fitiotlab/iot-lab-gateway .
#
# - tests: dev image with the test tools, runs the tests (make test,
#   make integration-test). Image fitiotlab/iot-lab-gateway-tests.
#
#       docker build --target tests -t fitiotlab/iot-lab-gateway-tests .
#
# - rootfs: root filesystem of the IoT-LAB gateways, deployed by
#   iot-lab-install and booted read-only over NFS, see rootfs/README.md.
#   The gateway server layer on top of fitiotlab/iot-lab-linux-base
#   (iot-lab-open-linux: netbooted system, kernels, IoT-LAB tools).
#   Platforms linux/arm/v7 (A8, Raspberry Pi 2/3/4), linux/arm64 (RPi 5).
#
#       docker buildx build --target rootfs --platform linux/arm/v7 \
#           --build-arg LINUX_BASE_IMAGE=fitiotlab/iot-lab-linux-base:<tag> .
#
# dev and tests share the tools and gateway stages (amd64 or ARM).

ARG DEBIAN_RELEASE=trixie
# Base of the rootfs target
ARG LINUX_BASE_IMAGE=fitiotlab/iot-lab-linux-base:latest

# Optional input, empty unless given as a named build context:
#   jlink: extracted Segger J-Link software for the target architecture,
#          installed in /usr/local/share/JLink (not redistributable)
FROM scratch AS jlink

#
# tools: tools used by the gateway code and not packaged in Debian, built
# from pinned revisions and installed under /out. The stage runs on the
# platform of the build machine and cross-compiles for the target platform
# (native build when they are the same, e.g. the dev image on amd64): no
# compilation under emulation for the ARM images.
#
FROM --platform=$BUILDPLATFORM debian:${DEBIAN_RELEASE} AS tools

ARG TARGETARCH

ARG OPENOCD_REV=v0.11.0
ARG OPENOCD_DEV_REV=7c88e76a76588fa0e3ab645adfc46e8baff6a3e4
ARG OML_REV=f3bffca8ca721678bcb61a716765ae4f4cae3fd7
ARG CONTROL_NODE_SERIAL_REV=3eee15a5d48d3e1536e42bd074ad351de6a5334d
ARG FTDI_UTILS_REV=1.1.0
ARG EDBG_REV=80c50d03aac831f87f513a5d5455df1286bcb540
ARG YKUSH_REV=30d490423782a1d5379d1691a2539fad6ff6046d
ARG MJPG_STREAMER_REV=8cc9d22c1e79905d529a248ccf05bbf0625e0bf3
ARG CC2538_BSL_REV=c6100a7794c7b530923145c03e37412013a4551e
ARG PYCOM_UTILS_REV=80aacc4b36df5d59d783c987fca77d83b12f7bf2

# Toolchain of the target: /etc/cross.env, sourced by the build steps
RUN case "$TARGETARCH" in \
        amd64) arch=amd64; host=x86_64-linux-gnu; processor=x86_64 ;; \
        arm) arch=armhf; host=arm-linux-gnueabihf; processor=arm ;; \
        arm64) arch=arm64; host=aarch64-linux-gnu; processor=aarch64 ;; \
        *) echo "unsupported target architecture: $TARGETARCH"; exit 1 ;; \
    esac; \
    cmake_cross=""; \
    if [ "$arch" != "$(dpkg --print-architecture)" ]; then \
        cmake_cross="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=$processor"; \
    fi; \
    printf '%s\n' \
        "DEB_HOST_ARCH=$arch" \
        "HOST=$host" \
        "CMAKE_CROSS=\"$cmake_cross\"" \
        "export CC=$host-gcc CXX=$host-g++" \
        "export PKG_CONFIG_LIBDIR=/usr/lib/$host/pkgconfig:/usr/share/pkgconfig" \
        > /etc/cross.env

# Build tools for the build machine, libraries for the target
RUN . /etc/cross.env && \
    if [ "$DEB_HOST_ARCH" != "$(dpkg --print-architecture)" ]; then \
        dpkg --add-architecture "$DEB_HOST_ARCH"; \
        cross_toolchain="crossbuild-essential-$DEB_HOST_ARCH"; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        git \
        gnulib \
        libtool \
        pkgconf \
        # oml2 build: test sources generated by python scripts
        python3 \
        ruby \
        texinfo \
        $cross_toolchain \
        libftdi1-dev:$DEB_HOST_ARCH \
        libhidapi-dev:$DEB_HOST_ARCH \
        libjpeg-dev:$DEB_HOST_ARCH \
        libpopt-dev:$DEB_HOST_ARCH \
        libsqlite3-dev:$DEB_HOST_ARCH \
        libudev-dev:$DEB_HOST_ARCH \
        libusb-1.0-0-dev:$DEB_HOST_ARCH \
        libxml2-dev:$DEB_HOST_ARCH \
        && \
    rm -rf /var/lib/apt/lists/*

# These tools predate GCC 14, which turns some old C idioms into errors
ENV CFLAGS="-O2 -fcommon -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion"

WORKDIR /src

# git_checkout <url> <revision> <directory>
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -e' \
        'git clone --quiet "$1" "$3"' \
        'git -C "$3" checkout --quiet "$2"' \
        > /usr/local/bin/git_checkout && \
    chmod 755 /usr/local/bin/git_checkout

# openocd: /usr/local/bin/openocd (v0.11.0) and /opt/openocd-dev (more
# recent revision), the paths used by the gateway code
RUN . /etc/cross.env && \
    git_checkout https://github.com/openocd-org/openocd.git ${OPENOCD_REV} openocd && \
    cd openocd && ./bootstrap && \
    ./configure --host="$HOST" --prefix=/usr/local --disable-werror \
        --enable-ftdi --enable-cmsis-dap --enable-hidapi-libusb && \
    make -j"$(nproc)" && make DESTDIR=/out install

RUN . /etc/cross.env && \
    git_checkout https://github.com/openocd-org/openocd.git ${OPENOCD_DEV_REV} openocd-dev && \
    cd openocd-dev && ./bootstrap && \
    ./configure --host="$HOST" --prefix=/opt/openocd-dev --disable-werror \
        --enable-ftdi --enable-cmsis-dap --enable-hidapi-libusb --enable-jlink && \
    make -j"$(nproc)" && make DESTDIR=/out install

# oml2, needed by control_node_serial, installed in /usr/local of /out
RUN . /etc/cross.env && \
    git_checkout https://github.com/iot-lab/oml.git ${OML_REV} oml && \
    cd oml && ./autogen.sh && \
    ./configure --host="$HOST" --prefix=/usr/local --disable-doc --disable-doxygen-doc \
        --disable-doxygen-dot --disable-android --disable-doxygen-html \
        --disable-option-checking && \
    make -j"$(nproc)" && make DESTDIR=/out install

# Built against the oml2 of /out, oml2-scaffold (ruby script) generates its
# OML header. Its Makefile appends to CFLAGS and LDFLAGS: given in the
# environment. The patch (same as iot-lab-yocto) fixes the printf format of
# 64-bit time_t on 32-bit targets (armhf), an error with -Werror.
COPY patches/control_node_serial/ /src/patches/control_node_serial/
RUN . /etc/cross.env && \
    git_checkout https://github.com/iot-lab/control_node_serial.git ${CONTROL_NODE_SERIAL_REV} control_node_serial && \
    git -C control_node_serial apply /src/patches/control_node_serial/*.patch && \
    PATH="/out/usr/local/bin:$PATH" \
    CFLAGS="$CFLAGS -I/out/usr/local/include" \
    LDFLAGS="-L/out/usr/local/lib -Wl,-rpath-link,/out/usr/local/lib" \
        make -C control_node_serial && \
    install -D -m 755 control_node_serial/control_node_serial_interface \
        /out/usr/bin/control_node_serial_interface

RUN . /etc/cross.env && \
    git_checkout https://github.com/iot-lab/iot-lab-ftdi-utils.git ${FTDI_UTILS_REV} ftdi-utils && \
    cd ftdi-utils && \
    make CC="$CC" CFLAGS="$CFLAGS $(pkg-config --cflags-only-I libftdi1) -DLIBFTDI1=1" \
        LDFLAGS="$(pkg-config --libs libftdi1)" && \
    install -D -m 755 -t /out/usr/bin ftdi-devices-list ftdi-eeprom-config

# The edbg Makefile calls gcc: use the compiler of the target
RUN . /etc/cross.env && \
    git_checkout https://github.com/ataradov/edbg.git ${EDBG_REV} edbg && \
    sed -i 's/^\tgcc /\t$(CC) /' edbg/Makefile && \
    make -C edbg all CC="$CC" && \
    install -D -m 755 edbg/edbg /out/usr/bin/edbg

# The ykush Makefile takes the include paths from $PWD: build from its
# directory
RUN . /etc/cross.env && \
    git_checkout https://github.com/Yepkit/ykush.git ${YKUSH_REV} ykush && \
    cd ykush && make CPP="$CXX" && \
    install -D -m 755 bin/ykushcmd /out/usr/bin/ykushcmd

# cmake directly (the wrapper Makefile can't cross-compile), installed in
# /usr: the gateway code runs /usr/bin/mjpg_streamer
RUN . /etc/cross.env && \
    git_checkout https://github.com/jacksonliam/mjpg-streamer.git ${MJPG_STREAMER_REV} mjpg-streamer && \
    cmake -S mjpg-streamer/mjpg-streamer-experimental -B mjpg-streamer/build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" \
        -DCMAKE_LIBRARY_ARCHITECTURE="$HOST" $CMAKE_CROSS && \
    make -C mjpg-streamer/build -j"$(nproc)" && \
    make -C mjpg-streamer/build DESTDIR=/out install

RUN git_checkout https://github.com/JelmerT/cc2538-bsl.git ${CC2538_BSL_REV} cc2538-bsl && \
    install -D -m 755 cc2538-bsl/cc2538-bsl.py /out/usr/bin/cc2538-bsl.py

RUN git_checkout https://github.com/iot-lab/pycom-utils.git ${PYCOM_UTILS_REV} pycom-utils && \
    install -d /out/usr/local/share/pycom/eps32/tools/fw_updater && \
    cp pycom-utils/*.py /out/usr/local/share/pycom/eps32/tools/fw_updater/

#
# gateway: the gateway code, its udev rules and the tools it uses
#
FROM debian:${DEBIAN_RELEASE} AS gateway

LABEL maintainer="IoT-LAB <admin@iot-lab.info>"

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        avarice \
        avrdude \
        ca-certificates \
        curl \
        libftdi1-2 \
        libhidapi-hidraw0 \
        libhidapi-libusb0 \
        libjpeg62-turbo \
        libpopt0 \
        libsqlite3-0 \
        libudev1 \
        libusb-1.0-0 \
        libxml2 \
        mosquitto \
        openssh-client \
        python3 \
        python3-bottle \
        python3-intelhex \
        python3-paste \
        python3-pip \
        python3-pyelftools \
        python3-serial \
        rtl-sdr \
        socat \
        sudo \
        uhubctl \
        usbutils \
        && \
    rm -rf /var/lib/apt/lists/*

COPY --from=tools /out/ /
COPY --from=jlink / /usr/local/share/JLink/
RUN ldconfig

# Gateway code, dependencies from the Debian packages above
COPY . /tmp/gateway
RUN pip install --no-cache-dir --no-deps --break-system-packages /tmp/gateway && \
    install -D -m 644 -t /etc/udev/rules.d /tmp/gateway/bin/rules.d/*.rules && \
    install -D -m 755 /tmp/gateway/bin/init_script/gateway-server-daemon \
        /usr/local/sbin/gateway-server-daemon && \
    rm -rf /tmp/gateway

# www-data runs the gateway server: serial ports, home for its ssh keys
RUN usermod -a -G dialout,plugdev www-data && \
    install -d -o www-data -g www-data -m 755 /var/www && \
    install -d -o www-data -g www-data -m 700 /var/www/.ssh && \
    mkdir -p /var/local/config /iotlab/users

#
# rootfs: root filesystem of the gateways (rootfs/README.md), the gateway
# server on top of iot-lab-linux-base. The base image has the system of a
# netbooted node (overlay /sbin/init, iotlab-boot-setup), the kernels and
# boot files of every gateway type and the IoT-LAB tools; the gateway code
# of this checkout replaces its pinned one.
#
FROM ${LINUX_BASE_IMAGE} AS rootfs

# Gateway server dependencies not in the base image
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        avarice \
        curl \
        mosquitto \
        rtl-sdr \
        uhubctl \
        && \
    rm -rf /var/lib/apt/lists/*

COPY --from=jlink / /usr/local/share/JLink/

COPY . /tmp/gateway
RUN pip install --no-cache-dir --no-deps --force-reinstall --break-system-packages /tmp/gateway && \
    install -D -m 644 -t /etc/udev/rules.d /tmp/gateway/bin/rules.d/*.rules && \
    install -D -m 755 /tmp/gateway/bin/init_script/gateway-server-daemon \
        /usr/local/sbin/gateway-server-daemon && \
    rm -rf /tmp/gateway && \
    mkdir -p /var/local/config /iotlab/users

# Gateway services: /iotlab/users mount, open node addresses, gateway server
COPY rootfs/files/ /
RUN chmod 440 /etc/sudoers.d/www-data && \
    systemctl enable iotlab-gateway-setup.service gateway-server-network.service \
        gateway-server.service

#
# tests: test tools on top of the gateway installation, runs the tests as
# the user of the host (tests/entrypoint.sh)
#
FROM gateway AS tests

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gdb \
        gdb-multiarch \
        gosu \
        # tox commands (clean-test-files)
        make \
        tox \
        valgrind \
        && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /iotlab/users/test && \
    chown www-data:www-data /iotlab/users/test

COPY tests/entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /shared

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["/bin/bash"]

#
# dev: gateway REST server in a container (default target), see DOCKER.md
#
FROM gateway AS dev

RUN mkdir -p /iotlab/users/test && \
    chown www-data:www-data /iotlab/users/test

CMD ["gateway-rest-server", "0.0.0.0", "8080", "--log-stdout", "--reloader"]
